# Copy to .env and fill in. Never commit the real .env.
# Consumed by entrypoint.sh in "simple" mode (no mounted /etc/litestream.yml).

# Path to the SQLite database inside the container.
DB_PATH=/data/app.db

# Litestream replica destination, e.g. s3://my-bucket/app-db or file:///replica
REPLICA_URL=

# sqlite-web ("web" mode) is read-only unless this is true.
WEB_WRITE=false

# S3-compatible replicas also read these (leave blank to use IAM / instance role):
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# Optional client-side age encryption (age keypair). Read by entrypoint.sh and
# spliced into the generated config; ignored when /etc/litestream.yml is mounted.
# Recipients (public) encrypt on replicate; identities (secret) decrypt on
# restore. Provide inline (comma/newline separated) or via a mounted *_FILE.
# LITESTREAM_AGE_RECIPIENTS=age1...
# LITESTREAM_AGE_RECIPIENTS_FILE=/keys/recipients.txt
# LITESTREAM_AGE_IDENTITIES=AGE-SECRET-KEY-...
# LITESTREAM_AGE_IDENTITIES_FILE=/keys/age.key
